<?xml version="1.0" encoding="UTF-8"?>
<server description="Feature list generated by binaryAppScanner">
    <featureManager>
        <!--The following features are available in all editions of Liberty.-->
        <feature>jsp-2.2</feature>
        <feature>jdbc-4.0</feature>
        <feature>jndi-1.0</feature>
    </featureManager>
    <library id="postgresLib">
        <fileset dir="/opt/drivers/postgres/" includes="postgresql-42.7.14.jar"/>
    </library>
    <dataSource id="postgresDs" jndiName="jdbc/labapp">
        <jdbcDriver libraryRef="postgresLib"/>
        <properties.postgresql serverName="192.168.0.112" portNumber="8082" databaseName="admin" user="admin" password="${env.DB_PASSWORD}"/>
    </dataSource>
    <webApplication id="labapp" name="labapp" contextRoot="/labapp" location="labapp.war"/>
    <httpEndpoint id="defaultHttpEndpoint" host="*" httpPort="9080"/>
</server>
